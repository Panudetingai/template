NEXT_PUBLIC_PRODUCT_NAME=Template MVP Setup ## Change this to your own product name
NEXT_PUBLIC_APP_TITLE=Template MVP Setup ## Change this to your own app title
NEXT_PUBLIC_APP_DESCRIPTION=Template MVP Setup Description ## Change this to your own app description
NEXT_PUBLIC_APP_URL=https://localhost:3000 ## Change this to your own app url
NEXT_PUBLIC_COOKIE_PREFIX="your-cookie-prefix" ## Change this to your own cookie prefix
NEXT_PUBLIC_SUPABASE_PROJECT_REF="your-supabase-project-ref" ## Change this to your own supabase project reference
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url" ## Change this to your own supabase url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key" ## Change this to your own supabase publishable key
NEXT_PUBLIC_SUPABASE_PRIVATE_KEY="your-supabase-private-key" ## Change this to your own supabase private key
NEXT_PUBLIC_API_URL="your-api-url" ## Change this to your own api url
NEXT_PUBLIC_WS_URL="ws://localhost:3000/api/ws-auth" ## Optional — defaults from NEXT_PUBLIC_API_URL
PORT=3000 ## Bun custom server (Next.js + Elysia + WebSocket)
NEXT_PUBLIC_SUPABASE_DATABASE_URL="your-supabase-database-url" ## Change this to your own supabase database url
NEXT_PUBLIC_SUPABASE_DATABASE_URL_ORM="your-supabase-database-url-orm" ## Change this to your own supabase database url for orm
GROQ_API_KEY="your-groq-api-key" ## Optional — used by the LLM/Groq scaffold (https://console.groq.com/)
