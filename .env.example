# LINE Mock Product webhook — https://developers.line.biz/console/
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/line/webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# ลงนามลิงก์ generateProduct.json (แนะนำ หรือใช้ร่วม KEY เดียวกับ LINE_CHANNEL_SECRET)
LINE_DOWNLOAD_SECRET=

# Design-to-product API (Worker) — พิมพ์ /designproduct ใน LINE แล้วส่งรูปดีไซน์ → รูปเสื้อ
# Defaults match the provided curl.
DESIGN_TO_PRODUCT_API_URL=https://ai-worker-api.codedroy3.workers.dev/api/design-to-product
DESIGN_TO_PRODUCT_API_KEY=your-development-api-key
# AI Worker (recommended) — ใช้ base URL เดียวสำหรับ /api/health, /api/generate, /api/design-to-product
AI_WORKER_BASE_URL=https://ai-worker-api.codedroy3.workers.dev
AI_WORKER_API_KEY=your-development-api-key
# แนบรูปเสื้อเป็นฟิลด์ที่สอง (เช่น garment); เว้นว่างถ้า API รับแค่ design + ข้อความ product
DESIGN_TO_PRODUCT_GARMENT_FORM_FIELD=
# ฟิลด์ product ใน multipart (default: white crew neck cotton t-shirt)
DESIGN_TO_PRODUCT_PRODUCT=

# Cloudinary — เก็บ URL ใน Postgres (Supabase) แทน base64; โฟลเดอร์ origin / product-ai-generate
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# optional overrides (defaults: origin, product-ai-generate)
CLOUDINARY_FOLDER_ORIGIN=
CLOUDINARY_FOLDER_PRODUCT_AI=
# optional — default folder name tiktok-posts (รูปโพสต์ TikTok ใน Cloudinary; ส่งให้ TikTok ผ่านโพรกซีโดเมนแอป)
CLOUDINARY_FOLDER_TIKTOK=

# TikTok — Login Kit + Content Posting (see /dashboard/tiktok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional — ลงนาม URL โพรกซี /api/tiktok/media-pull/ (ถ้าไม่ตั้ง ใช้ derived จาก TIKTOK_CLIENT_SECRET)
# ใน TikTok Portal ให้ verify URL prefix: https://<โดเมนที่ deploy>/api/tiktok/media-pull/
TIKTOK_MEDIA_PULL_SECRET=
# Optional. Comma-separated; must match scopes enabled in TikTok app (และเปิด product Content Posting ในคอนโซล)
# Default (if unset) ในโค้ด: user.info.basic,video.publish,video.list — ถ้าเชื่อมตั้งแต่เมื่อเก่ากว่านี้อาจเหลือแค่ user.info.basic → ให้ Disconnect แล้วเชื่อมใหม่
TIKTOK_OAUTH_SCOPES=
# Optional. If set, must match the Login redirect URL in TikTok Developer console exactly (scheme, host, path), no trailing slash.
# If unset, redirect_uri = {same origin as /api/tiktok/oauth/start}/api/tiktok/oauth/callback — register that exact URL in the console (e.g. ngrok URL when testing).
TIKTOK_REDIRECT_URI=
# ค่า 1 = บังคับโพสต์แบบ SELF_ONLY ที่เซิร์ฟเวอร์ (จำเป็นเมื่อแอปยังไม่ผ่าน Content Posting audit — ดู content-sharing-guidelines)
TIKTOK_UNAUDITED_SELF_ONLY=1

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=