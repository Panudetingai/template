# ── Server ───────────────────────────────────────────────
PORT=4000
# Origin of the web app. Used for CORS and for Stripe success/cancel/return URLs.
WEB_URL=http://localhost:3000

# ── Database (Supabase Postgres) ─────────────────────────
# Use the Session pooler URI (port 5432) — recommended for drizzle-kit.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase (used to verify access tokens sent by the web app) ──
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Server-only. Never expose to the browser. Used to update auth metadata.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ── Cache / rate limit (optional — falls back to in-memory) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI (optional — /ai routes return 503 until set) ──────
GROQ_API_KEY=
AI_DEFAULT_MODEL=llama-3.3-70b-versatile
AI_RATE_LIMIT_PER_MINUTE=20

# ── Stripe (optional — /billing routes return 503 until set) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
