# Copy to .env.local — only browser-safe values live here.
NEXT_PUBLIC_PRODUCT_NAME="My Product"
NEXT_PUBLIC_APP_TITLE="My Product"
NEXT_PUBLIC_APP_DESCRIPTION="What my product does"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COOKIE_PREFIX="my-product"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_PROJECT_REF="your-project-ref"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# The standalone API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4000
