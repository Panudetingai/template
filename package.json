{
  "name": "template",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:web": "bun run --filter @template/web dev",
    "dev:api": "bun run --filter @template/api dev",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter @template/api test",
    "db:generate": "bun run --filter @template/api db:generate",
    "db:migrate": "bun run --filter @template/api db:migrate",
    "db:seed": "bun run --filter @template/api db:seed"
  },
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
